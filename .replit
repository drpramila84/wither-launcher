modules = ["java-graalvm22.3", "bash", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo 'PojavLauncher - Android Minecraft Launcher' && echo '' && echo 'This is an Android app project. It cannot run in the Replit environment.' && echo 'Use Android Studio or CI/CD (GitHub Actions) to build the APK.' && echo '' && echo 'Build command: ./gradlew :app_pojavlauncher:assembleDebug' && echo 'Output: app_pojavlauncher/build/outputs/apk/debug/' && echo '' && echo 'See replit.md for full project documentation.'"

[workflows.workflow.metadata]
outputType = "console"
